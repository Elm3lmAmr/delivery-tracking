# ---------- Server ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=edara
DB_PASSWORD=change_me
DB_NAME=edara_delivery

# ---------- Auth ----------
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
DRIVER_JWT_EXPIRES_IN=30d

# ---------- File storage ----------
# Options: 'local' | 's3' | 'r2'
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=8

# S3 / R2 (if used)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ---------- Third-party services ----------
# SMS provider for OTP (Vonage, Msegat, Twilio)
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=EDARA

# Face matching service (AWS Rekognition, Azure Face)
FACE_MATCH_PROVIDER=stub
FACE_MATCH_THRESHOLD=90

# ---------- Business rules ----------
QR_EXPIRY_MINUTES=30
DEFAULT_SLA_MINUTES=20
FURNITURE_SLA_MINUTES=45
GPS_PING_INTERVAL_SECONDS=5
NO_GPS_ALERT_SECONDS=180
